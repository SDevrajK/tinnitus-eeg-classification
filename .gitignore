# Personal memory/context state (BBmem) — not part of the project
.memory/

# Python
__pycache__/
*.py[cod]
*$py.class

# Data lives on the 10TB HDD, outside this repo — no data files should ever be tracked
*.gdf
*.fdt
*.set
*.npz
*.zip
*.mat
*.fif

# Guard against a stray data/ directory ever being created in the repo root
# (e.g. a script run with a relative path instead of the HDD path — this has
# happened once already; see specs/tinnitus-eeg-interpretability/phase2/audit.md)
/data/

# all specs are gitignored
specs/